# Round-trip test
payload = 'the rain in Spain falls mainly on the plain'
result  = encode(payload, SEED)
inv     = invert(result['digest'], result['absJ'], result['jHang'], result['N'])
bSeq    = payload_bits(payload)

seedOk  = abs(inv['recSeed'] - SEED) < 1e-13
bitsOk  = inv['recBits'] == bSeq

print(f"Payload   : '{payload}'")
print(f"N         : {result['N']} steps")
print(f"Digest    : {result['digest']:.14f}")
print(f"jHang     : {result['jHang']:+d}")
print(f"Seed rec  : {inv['recSeed']:.14f}  {'✓' if seedOk else '✗'}")
print(f"Bits rec  : {len(inv['recBits'])}/{len(bSeq)}  {'✓' if bitsOk else '✗'}")
print()

# J-stream
J   = result['J'][1:]
bad = [j for j in J if j not in (-1, 0, 1)]
print(f"J-stream  N={result['N']}  -1:{J.count(-1)}  0:{J.count(0)}  +1:{J.count(1)}")
print(f"Ternary   : {'PASS ✓' if not bad else 'FAIL ' + str(bad[:5])}")
print()

# Band structure
band = digest_band(result['digest'])
B, C = band_bc(band)
print(f"Band      : {band}  (B={B}, C={C})")
