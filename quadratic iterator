# CANONICAL QUADRATIC ITERATOR v2

# 

# Phillip Somerville (@unitambo)

# 

# f(x) = (x² - F)² - F

# 

# Zero-event encoding: J interrogation determines target/control at each step.

# Chained inversion from digest + |J| stream + jHang alone.

# No stored orbit, no stored F, no signed J transmitted.

# 

# See README v5 for full architectural description.

import math

# ── PARAMETERS ────────────────────────────────────────────────────────────────

PL   = 1.094     # base parameter  (bit 0, control −1)
D    = 0.002     # delta           (PL + D = 1.096, bit 1, control +1)
T    = 0.08781   # threshold       (midpoint of x→y band gap, never visited)
SEED = 0.087801  # canonical seed  (symmetric register splitting)

# ── PRECISION ─────────────────────────────────────────────────────────────────

def tr14(x):
“””
Snap x to the 14dp lattice using symmetric rounding.
Defines the discrete orbit space. Applied only at the output of each
forward step and each inverse interrogation — never at intermediates.
“””
f = 10 ** 14
return round(x * f) / f

def sgn(x):
return 0 if x == 0.0 else (1 if x > 0 else -1)

# ── BIT EXPANSION ─────────────────────────────────────────────────────────────

def payload_bits(text):
“”“UTF-8 bytes → bit sequence, big-endian per byte. No closing zeros.”””
bits = []
for byte in text.encode(‘utf-8’):
for i in range(7, -1, -1):
bits.append((byte >> i) & 1)
return bits

# ── FORWARD ENCODING ──────────────────────────────────────────────────────────

def encode(text, seed=SEED):
“””
Zero-event forward expansion.

```
n=1:  always target — consume first payload bit, no J interrogation.
n≥2:  interrogate H[n-1] under its register parameter:
          Fp    = PL+D if H[n-1] > T else PL
          k     = tr14(sqrt(Fp − sqrt(H[n-1] + Fp)))
          J[n]  = sgn(k − H[n-2])
      J[n]=0  → target:  F = PL + bit * D  (consume payload bit)
      J[n]=+1 → control: F = PL + D = 1.096
      J[n]=−1 → control: F = PL     = 1.094

Channel patency: F=1.096 always produces upper register (H[n] > T),
                 F=1.094 always produces lower register (H[n] ≤ T).
                 This is the foundation of derived inversion.

Returns:
    digest  H[N]           terminal orbit value
    absJ    |J[1..N]|      unsigned stream (0 or 1 per step)
    jHang   signed ∈ {-1,0,+1}  terminal boundary correction
    N       total step count
    H       full orbit (for reference/verification only)
    J       signed J stream (for reference/verification only)
"""
bSeq = payload_bits(text)
bi   = 0       # payload bit index
H    = [seed]
J    = [None]  # J[0] unused
F_   = [None]  # F_[0] unused

def step(h, f):
    v = h * h - f
    return tr14(v * v - f)

def interrogate(h1, h2):
    Fp  = (PL + D) if h1 > T else PL
    inn = h1 + Fp
    if inn >= 0:
        v2 = Fp - math.sqrt(inn)
        if v2 >= 0:
            return sgn(tr14(math.sqrt(v2)) - h2)
    return sgn(h1 - h2)

# n=1: always target
bit = bSeq[bi]; bi += 1
fn  = PL + bit * D
H.append(step(H[0], fn))
J.append(0)
F_.append(fn)

# n≥2: zero-event loop
while bi < len(bSeq):
    h1 = H[-1]; h2 = H[-2]
    j  = interrogate(h1, h2)
    if j == 0:
        bit = bSeq[bi]; bi += 1
        fn  = PL + bit * D
    else:
        fn = (PL + D) if j == 1 else PL
    H.append(step(h1, fn))
    J.append(j)
    F_.append(fn)

N = len(H) - 1

# Hanging J: signed boundary correction at terminal position
# Derived from register of H[N] — no stored F used
h1  = H[N]; h2 = H[N - 1]
Fp  = (PL + D) if h1 > T else PL
inn = h1 + Fp
if inn >= 0:
    v2 = Fp - math.sqrt(inn)
    jHang = sgn(tr14(math.sqrt(v2)) - h2) if v2 >= 0 else sgn(h1 - h2)
else:
    jHang = sgn(h1 - h2)

absJ = [abs(j) for j in J[1:]]  # |J[1..N]|

return {
    'digest': H[N],
    'absJ':   absJ,
    'jHang':  jHang,
    'N':      N,
    'H':      H,       # full orbit — for verification only
    'J':      J,       # signed J  — for verification only
}
```

# ── CHAINED INVERSION ─────────────────────────────────────────────────────────

def invert(digest, absJ, jHang, N):
“””
Chained inversion from transmitted record alone.
Inputs:  digest, |J[1..N]|, jHang, N
No stored H, no stored F, no signed J.

```
Synchronisation rule:
  At inversion step i (n = N−i+1):
    Parameter  (immediate):  Fp = anchor > T ? PL+D : PL
    Correction (1-step lag): uses |J[n+1]| and sign from prevAnchor register
    Bit flag   (current):    uses |J[n]|

Returns:
    recBits   recovered payload bits (in order)
    recSeed   recovered seed
    steps     list of per-step detail dicts
"""
steps   = []
recBits = []

anchor     = digest
prevAnchor = digest

def k_of(anch):
    Fp  = (PL + D) if anch > T else PL
    inn = anch + Fp
    return tr14(math.sqrt(Fp - math.sqrt(inn))), Fp

# Capture first target bit if |J[N]| = 0
if absJ[N - 1] == 0:
    recBits.append(1 if digest > T else 0)

# i=1: static — apply signed jHang
k, Fp = k_of(anchor)
rec   = k if jHang == 0 else tr14(k - jHang * 1e-14)
steps.append({'i': 1, 'anchor': anchor, 'Fp': Fp, 'k': k,
              'jAbsCorr': abs(jHang), 'jSgn': jHang, 'rec': rec, 'bit': None})
prevAnchor = anchor
anchor     = rec

# i=2..N: chained
for i in range(2, N + 1):
    n          = N - i + 1
    k, Fp      = k_of(anchor)
    jAbsCorr   = absJ[n] if n < len(absJ) else 0   # |J[n+1]|
    jAbsThis   = absJ[n - 1]                         # |J[n]|
    prevUpper  = prevAnchor > T
    jSgn       = (1 if prevUpper else -1) if jAbsCorr == 1 else 0
    rec        = tr14(k - jSgn * 1e-14) if jAbsCorr == 1 else k
    bit        = None
    if jAbsThis == 0:
        bit = 1 if anchor > T else 0
        recBits.append(bit)
    steps.append({'i': i, 'anchor': anchor, 'Fp': Fp, 'k': k,
                  'jAbsCorr': jAbsCorr, 'jSgn': jSgn, 'rec': rec, 'bit': bit})
    prevAnchor = anchor
    anchor     = rec

return {
    'recBits': list(reversed(recBits)),
    'recSeed': anchor,
    'steps':   steps,
}
```

# ── NOTE: D* FIXED POINT ─────────────────────────────────────────────────────

# 

# The D* fixed-point property (encode(text, D*)[‘digest’] == D*) applied to

# the old simple encoding where F was determined purely by payload bits.

# The zero-event scheme breaks this property: J interrogation makes orbit

# length variable, so the fixed-point iteration does not converge.

# D* and rhyme detection are not applicable to this implementation.

# 

# ── BAND STRUCTURE ────────────────────────────────────────────────────────────

def d_star(text, seed=SEED):
“””
Seed-independent canonical digest D*.
Satisfies: encode(text, D*)[‘digest’] == D*
Convergence guaranteed in ≤ 2 loops.
“””
s = seed
for _ in range(20):
d = encode(text, s)[‘digest’]
if abs(d - s) < 1e-15:
return d
s = d
return s

# ── BAND STRUCTURE ────────────────────────────────────────────────────────────

BAND_BOUNDARIES = [
(0.08636316488056, 0.08645049942242),  # band 1 — lower lateral  w
(0.08648981066002, 0.08657545468422),  # band 2 — lower medial   x
(0.08669545053069, 0.08678420037717),  # band 3
(0.08682443149389, 0.08691142795026),  # band 4
(0.08781118962651, 0.08790084886874),  # band 5 — upper medial   y
(0.08794169894719, 0.08802964069811),  # band 6
(0.08815360499332, 0.08824478706384),  # band 7
(0.08828655569850, 0.08837595523818),  # band 8 — upper lateral  z
]

def digest_band(digest):
for i, (lo, hi) in enumerate(BAND_BOUNDARIES):
if lo <= digest <= hi:
return i + 1
return 0

def band_bc(band):
if not band:
return None, None
return (0 if band <= 4 else 1), (0 if (band - 1) % 4 < 2 else 1)

